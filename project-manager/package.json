{
  "name": "@local/dsh-project-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Project and file manager for DeepSeek Harness: one folder per project, safe file operations, recent work, and session entry points.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
